# ==============================================================================
# AutoApply Environment Configuration Example
# Copy this file to .env and fill in your keys (or configure via the Web UI Settings)
# ==============================================================================

# ── AI API Keys (Optional here — can also be entered directly in Web UI Settings ⚙) ──
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# ── Gmail Outreach Settings (Optional here — can also be entered in Web UI Settings ⚙) ──
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# ── MongoDB Atlas (Optional — if omitted, AutoApply uses automatic Local JSON Storage) ──
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=autoapply

# ── Chrome DevTools Protocol (CDP) Settings ──
# Run start_chrome.bat (Windows) or ./start_chrome.sh (Mac/Linux) to launch Chrome on port 9222
CDP_URL=http://localhost:9222

# ── Clerk Authentication (Optional — default test key is preconfigured in dashboard/index.html) ──
# To use your own Clerk instance, create a project at https://clerk.com and update dashboard/index.html
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ── Axiom Observability & Cloud Logging ──
AXIOM_API_KEY=xaat-your_axiom_api_key_here
AXIOM_DATASET=applyinflow
AXIOM_INGEST_URL=https://us-east-1.aws.edge.axiom.co/v1/ingest/applyinflow
